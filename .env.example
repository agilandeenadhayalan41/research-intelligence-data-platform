# Copy to .env for Docker Compose only; Python does not load .env automatically.
# Replace the empty local password before starting PostgreSQL. Never commit it.
POSTGRES_USER=research
POSTGRES_DB=research
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Set a local PostgreSQL DSN in the process environment when adapters are implemented.
POSTGRES_DSN=

# Optional sandbox identifiers; no project IDs or credentials in tracked files.
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
BIGQUERY_DATASET=
# Optional local ADC file path OUTSIDE the repository; workload identity later.
GOOGLE_APPLICATION_CREDENTIALS=
